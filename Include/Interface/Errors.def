/*
    Pure Runtime Error Definitions Table
    Format: PURE_ERROR(EnumName, CodeValue, DescriptionString)
*/
PURE_ERROR(PURE_OK,                            0, "Success")
PURE_ERROR(PURE_ERROR_NULL_POINTER,            1, "Null pointer argument")
PURE_ERROR(PURE_ERROR_INVALID_ARGUMENT,        2, "Invalid argument passed")
PURE_ERROR(PURE_ERROR_OUT_OF_MEMORY,           3, "Memory allocation failed")
PURE_ERROR(PURE_ERROR_OUT_OF_BOUNDS,           4, "Index out of bounds")
PURE_ERROR(PURE_ERROR_BUFFER_TOO_SMALL,        5, "Buffer provided is too small")
PURE_ERROR(PURE_ERROR_ARRAY_FULL,              6, "Array maximum capacity reached")
PURE_ERROR(PURE_ERROR_STRING_FULL,             7, "String capacity full")
PURE_ERROR(PURE_ERROR_STRING_TOO_LONG,         8, "String length exceeds maximum limit")
PURE_ERROR(PURE_ERROR_STRING_BUILDER_FULL,     9, "String builder capacity full")
PURE_ERROR(PURE_ERROR_FILE_NOT_FOUND,          10, "File or path not found")
PURE_ERROR(PURE_ERROR_FILE_ACCESS_DENIED,      11, "Permission denied accessing file")
PURE_ERROR(PURE_ERROR_FILE_READ_FAILED,        12, "Failed to read from file")
PURE_ERROR(PURE_ERROR_FILE_WRITE_FAILED,       13, "Failed to write to file")
PURE_ERROR(PURE_ERROR_FILE_EOF,                14, "End of file reached")
PURE_ERROR(PURE_ERROR_DIRECTORY_CREATE_FAILED, 15, "Failed to create directory")
PURE_ERROR(PURE_ERROR_DIRECTORY_DELETE_FAILED, 16, "Failed to delete directory")
PURE_ERROR(PURE_ERROR_DIRECTORY_WALK_FAILED,   17, "Directory traversal failed or completed")
PURE_ERROR(PURE_ERROR_ENV_VAR_NOT_FOUND,       18, "Environment variable not found")
PURE_ERROR(PURE_ERROR_PROCESS_CREATE_FAILED,   19, "Failed to execute process")
PURE_ERROR(PURE_ERROR_PROCESS_WAIT_FAILED,     20, "Failed waiting for process completion")
PURE_ERROR(PURE_ERROR_UNKNOWN,                 21, "Unknown error")